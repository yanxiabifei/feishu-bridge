{
  "name": "feishu-bridge",
  "version": "0.3.4",
  "description": "飞书双向 AI 终端桥：手机与本地 Claude Code / Codex 会话双向同步",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanxiabifei/feishu-bridge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "feishu",
    "lark",
    "claude-code",
    "codex",
    "conpty",
    "remote-terminal"
  ],
  "main": "app/main.js",
  "scripts": {
    "start": "node bin/daemon.js",
    "window": "electron .",
    "setup": "node bin/setup.js",
    "autostart": "node scripts/autostart.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test test/e2e.test.js",
    "check:logs": "node scripts/check-logs.js",
    "pack": "electron-packager . --out=dist --overwrite --asar --ignore=\"^/dist($|/)\" --ignore=\"^/docs($|/)\" --ignore=\"^/test($|/)\" --ignore=\"^/logs($|/)\" --ignore=\"^/state($|/)\" --ignore=\"^/node_modules/(node-pty|@larksuiteoapi|@xterm/headless|@xterm/addon-serialize)($|/)\""
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.77.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.1",
    "electron": "^45.5.0"
  }
}
